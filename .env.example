# Connect Upstash for Redis in Vercel > Storage. Keep these values server-only.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-server-token
# Vercel's KV_REST_API_URL and KV_REST_API_TOKEN are also accepted.

# Cloudflare Realtime TURN. Server-only: never use NEXT_PUBLIC_ for these secrets.
CLOUDFLARE_TURN_KEY_ID=replace-with-your-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=replace-with-your-turn-key-api-token

# Optional account-wide TURN consumption guard. Read-only Account Analytics token.
# Configure both values together. No NEXT_PUBLIC_ prefix.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
CLOUDFLARE_ANALYTICS_API_TOKEN=replace-with-your-read-only-analytics-token
# Decimal GB per UTC calendar month; warning at 80%. Default 900.
TURN_MONTHLY_BUDGET_GB=900
# Set false to stop issuing new TURN credentials (direct connections remain).
TURN_ENABLED=true
